{
  "name": "datadog-upload-code-coverage-action",
  "version": "1.0.0",
  "type": "module",
  "description": "Fast GitHub Action to upload code coverage files to DataDog",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --transpile-only --license licenses.txt",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "all": "npm run format && npm run lint && npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/datadog-upload-code-coverage-action.git"
  },
  "keywords": [
    "datadog",
    "code-coverage",
    "github-actions",
    "ci",
    "coverage"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "axios": "^1.15.2",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.39.2",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.0"
  }
}
